# OpenSys Web Guardian — defaults do CT Proxmox (piloto Fase B).
# Sobrescreva via env antes de rodar o script, ou edite e exporte.

CTID=
HOSTNAME=opensys-wg
OSTEMPLATE=debian-12-standard_12.7-1_amd64.tar.zst
STORAGE=local-lvm
TEMPLATE_STORAGE=local
BRIDGE=vmbr0
CORE_COUNT=2
RAM_MB=2048
SWAP_MB=512
DISK_GB=32
PRIVILEGED=1
TZ=America/Sao_Paulo
PANEL_PORT=5001
LICENSE_SERVER_URL=https://licensewg.opensys.com.br

# Origem dos scripts / seeds (repo público opensys-proxmox)
OPENSYS_REPO_RAW=https://raw.githubusercontent.com/darlanpicetti/opensys-proxmox/main
OPENSYS_PROXMOX_BASE=

# Registry apt (mesmo canal do lab .33)
OPENSYS_UPDATES_REGISTRY_ORG=darlanpicetti
OPENSYS_UPDATES_REGISTRY_SLUG=opensys-web-guardian
OPENSYS_UPDATES_REPO_URI=https://packages.buildkite.com/darlanpicetti/opensys-web-guardian/any/
OPENSYS_UPDATES_REPO_SUITE=any
OPENSYS_UPDATES_REPO_COMPONENTS=main
OPENSYS_UPDATES_REPO_KEYRING=/usr/share/keyrings/opensys-buildkite-archive-keyring.gpg

# Fallback e2guardian 5.6 se opensys-e2guardian não estiver no registry
E2GUARDIAN_DEB_URL=https://e2guardian.numsys.eu/v5.6/e2debian_bookworm_V5.6.1_20260330.deb
